# Copy this file to ".env" (same folder) and fill in the values.

# Gemini API key from https://aistudio.google.com/apikey
# (You can also paste it in the website: Settings -> AI Detection)
GEMINI_API_KEY=

# Optional: Google Sign-In. Create an OAuth "Web application" client ID in
# Google Cloud Console and add http://localhost:8000 as an Authorized JavaScript origin.
GOOGLE_CLIENT_ID=
